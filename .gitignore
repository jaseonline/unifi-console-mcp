.venv/
__pycache__/
*.pyc
.pytest_cache/
downloads/
*.tgz
*.unifi
probe_out/

# Browser captures contain session cookies: never commit
*.har
# The folder har-files/ needs to be disabled for Claude to read DO NOT COMMIT ANYTHING WHILE THIS FOLDER IS COMMENTED OUT
har-files/ 

# Never commit local state, captures or logs
*.log
*.err
journal/
.env*
!.env.example
.vscode/
*.jsonl

# Local Claude Code state stays out; project skills are tracked (sync_public.py still keeps .claude/ off the public repo)
.claude/*
!.claude/skills/
_pub/

# MCPB build output
dist/
*.mcpb

# openapi-format output (copies of the spec)
src/unifi_console_mcp/formatted*.yaml
