# Configuration reference for unifi-console-mcp. Placeholder values only.
#
# The server does NOT read a .env file. Put the values you need in the "env" block of your MCP client's server
# entry, or set them as persistent user environment variables (setx or System Properties on Windows; the server reads
# those from the registry when its own environment lacks them). The Claude Desktop extension has a settings form
# instead; its blank fields fall back to these variables.

# --- Connection ---
UNIFI_LOCAL_HOST=192.168.1.2
UNIFI_LOCAL_PORT=443
UNIFI_DEFAULT_SITE=default
# Also read when the two above are unset: UNIFI_NETWORK_PORT, UNIFI_NETWORK_SITE

# --- Credentials (a dedicated local account without MFA; keep real values in a password manager) ---
UNIFI_MCP_USERNAME=your-local-account
UNIFI_MCP_PASSWORD=
# Only needed for Integration API operations
UNIFI_MCP_API_KEY=

# --- TLS: pin the console certificate (preferred) or, not recommended, turn verification off ---
UNIFI_CONSOLE_CERT_SHA256=
UNIFI_LOCAL_VERIFY_SSL=true

# --- Writes: off by default; list only the entities you need ---
UNIFI_CONSOLE_ENABLE_WRITES=false
UNIFI_CONSOLE_WRITE_ENTITIES=

# Secrets for writes come only from the environment, never from tool arguments:
# UNIFI_WIFI_<NAME>=   Wi-Fi passphrase for the network <NAME>
# UNIFI_DDNS_<NAME>=   Dynamic DNS token for <NAME>

# --- Optional ---
UNIFI_CONSOLE_JOURNAL_DIR=~/.unifi-console-mcp/journal
UNIFI_CONSOLE_DOWNLOAD_DIR=~/.unifi-console-mcp/downloads
UNIFI_HOME_DOMAIN=example.home
UNIFI_CONSOLE_DNS_PROBE_SERVER=
UNIFI_CONSOLE_DNS_PROBE_WINDOW=
UNIFI_CONSOLE_INTERNET_PROBE=1.1.1.1:443,9.9.9.9:443
UNIFI_CONSOLE_MAX_CHARS=40000
UNIFI_CONSOLE_SPEC_PATH=
UNIFI_CONSOLE_LOG_LEVEL=INFO
